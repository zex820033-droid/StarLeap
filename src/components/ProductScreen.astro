---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Arrow from './Arrow.astro';
import { site } from '../content/site';
interface Props { id?: string; image: ImageMetadata; alt: string; caption: string; }
const { id, image, alt, caption } = Astro.props;
---
<figure class="product-screenshot" id={id}>
  <a class="image-preview-trigger" href={image.src} data-image-preview={caption} aria-label={`${caption}，${site.editorial.viewLarge}`}>
    <Image src={image} alt={alt} format="webp" quality={90} widths={[480, 800, 1220]} sizes="(max-width: 800px) 90vw, 800px" loading="lazy" decoding="async" />
  </a>
  <figcaption><span>{caption}</span><a href={image.src} data-image-preview={caption}>{site.editorial.viewLarge}<Arrow /></a></figcaption>
</figure>
